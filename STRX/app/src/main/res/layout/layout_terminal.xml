<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- 终端主体区域（侧栏悬浮其上，收起时不占位、不留黑条） -->
    <FrameLayout
        android:id="@+id/terminal_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.termi.app.terminal.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 多窗口侧栏：悬浮于终端右侧，高度自适应（收起时只占一个 tab） -->
        <com.termi.app.TerminalSideBar
            android:id="@+id/terminal_sidebar"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end" />

        <!-- 窗口选择页（长按侧栏 tab 时显示，覆盖终端区） -->
        <LinearLayout
            android:id="@+id/windowPickerPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F00E1116"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPickerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="窗口"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#DCD8E0" />

            <TextView
                android:id="@+id/tvPickerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#B4B0BC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickerSwitch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="切换环境" />

                <Button
                    android:id="@+id/btnPickerClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="关闭" />
            </LinearLayout>

            <!-- 左下角：无操作倒计时（到 0 自动返回） -->
            <TextView
                android:id="@+id/tvPickerCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="start"
                android:text=""
                android:textSize="12sp"
                android:textColor="#8E8A98" />
        </LinearLayout>
    </FrameLayout>

    <!-- 终端快捷设置条：主题切换 + 字体大小 -->
    <LinearLayout
        android:id="@+id/terminal_settings_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FF161B22">

        <Spinner
            android:id="@+id/spTermTheme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="字号"
            android:textColor="#FFE6EDF3"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <SeekBar
            android:id="@+id/sbTermFontSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="20"
            android:progress="4" />

        <Button
            android:id="@+id/btnHomeBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="回左下"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ExtraKeys 快捷键栏 -->
    <com.termi.app.terminal.ExtraKeysView
        android:id="@+id/extra_keys"
        android:layout_width="match_parent"
        android:layout_height="40dp" />

</LinearLayout>
