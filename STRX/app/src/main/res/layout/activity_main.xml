<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tab 栏 + 下方的加载指示条（LOGIN/EXIT 期间显示） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="控制面板" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="终端" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="环境" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 加载指示条：紧贴 Tab 栏底边，与选中指示条同位置；
             indeterminate 样式自带往返滑动动画，读作"下划线正在加载" -->
        <ProgressBar
            android:id="@+id/pbTabLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Page 0: 控制面板 -->
        <include layout="@layout/fragment_control" />

        <!-- Page 1: 终端 -->
        <include layout="@layout/layout_terminal" />

        <!-- Page 2: 环境 -->
        <include layout="@layout/fragment_env" />

    </ViewFlipper>

</LinearLayout>
